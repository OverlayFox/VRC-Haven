<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plays an HLS URL through Windows Media Foundation, the stack VRChat's AVPro player uses on PC,
    and exits 0 only once video actually plays. Used by the Windows e2e CI job, see src/e2e/mf_windows_test.go.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Lets the project build on Linux too, so it can be compile checked outside Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
