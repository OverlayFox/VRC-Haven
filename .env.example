LOG_LEVEL=

# MaxMind Info
MAX_MIND_LICENSE_KEY=
MAX_MIND_ACCOUNT_ID=

# Serves Go profiles for `go tool pprof` on this address, off when empty, keep it off public interfaces
PPROF_ADDR=localhost:6060

# Dashboard, ports below 1024 need root or CAP_NET_BIND_SERVICE
DASHBOARD_PORT=80
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Escort only: host:port of the flagship's SRT server, defaults to 127.0.0.1:8890
FLAGSHIP_SRT_ADDR=
# Passphrase (10 to 79 characters) and stream ID, escorts must use the same as their flagship, default to thisisaverysecurepassphrase and test
HAVEN_PASSPHRASE=
HAVEN_STREAM_ID=
# Escort only: port the escort serves HLS on, defaults to 8555
HLS_PORT=
# Escort only: host:port the flagship redirects viewers to, defaults to this escort's IP and HLS port
HLS_PUBLIC_ADDR=
