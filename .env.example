# Required by both flagship and escort
SRT_PASSPHRASE=
SRT_STREAM_ID=

# Required by flagship only
GEO_ACCOUNT_ID=
GEO_LICENSE_KEY=

# Required by escort only
HAVEN_FLAGSHIP_ADDRESS=
HAVEN_FLAGSHIP_PORT=

# Optional, shown with their default values
DASHBOARD_USERNAME= # if left blank, the dashboard will be disabled
DASHBOARD_PASSWORD=
DASHBOARD_ADDRESS=127.0.0.1
DASHBOARD_PORT=8090

# Can be used to override the default location of the geo databases.
GEO_DB_DIRECTORY=./geoDatabases

# Can be used to set a custom public address and port for the flagship to redirect to.
# If left blank, the flagship will redirect to the public IP address of the client and the port set in the HLS_PORT variable.
#
# This can be used to for example redirect to my.customdomain.com:4242 while the HLS server is running on 127.0.0.1:8080
# The router would then need to redirect any traffic from my.customdomain.com:4242 to 127.0.0.1:8080
HAVEN_PUBLIC_ADDRESS=
HAVEN_PUBLIC_PORT=0

# Address and port for the flagship to listen on for incoming connections from escorts.
HLS_ADDRESS=127.0.0.1
HLS_PORT=8080
# The following variables control the read and write queue sizes and timeouts for HLS connections.
HLS_READ_QUEUE_SIZE=8192
HLS_READ_TIMEOUT=10s
HLS_WRITE_QUEUE_SIZE=8192
HLS_WRITE_TIMEOUT=10s

# Set log level
LOG_LEVEL=info

# Profiler address and port for pprof. If left blank, pprof will be disabled.
PROFILER_ADDRESS=
PROFILER_PORT=0

# Address and port the SRT server will listen on for incoming connections from the flagship.
SRT_ADDRESS=127.0.0.1
SRT_PORT=8890
